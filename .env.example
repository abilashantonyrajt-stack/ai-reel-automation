# ── AI Providers (at least one required) ──

# OpenAI / OpenRouter / any OpenAI-compatible API
OPENAI_API_KEY=sk-your-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
# For OpenRouter:
# OPENAI_BASE_URL=https://openrouter.ai/api/v1

# Replicate (for image generation via Stable Diffusion / Flux)
REPLICATE_API_TOKEN=r8_your-token-here

# ── Instagram Upload ──
# Option A: Meta Graph API (requires Instagram Business/Creator account)
META_APP_ID=your-meta-app-id
META_APP_SECRET=your-meta-app-secret
INSTAGRAM_BUSINESS_ID=your-instagram-business-id
META_ACCESS_TOKEN=your-long-lived-access-token

# Option B: Playwright browser automation (works with personal accounts)
# No env vars needed — will prompt for login credentials at runtime

# ── Video Settings ──
REEL_WIDTH=1080
REEL_HEIGHT=1920
REEL_DURATION_SECONDS=15
